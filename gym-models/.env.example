# ==============================================================================
# Gym SOA Management System - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# API Gateway Configuration
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_HTTP_TIMEOUT=10.0
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Downstream Microservices URLs (consumed by API Gateway)
# ------------------------------------------------------------------------------
USER_SERVICE_URL=http://127.0.0.1:8001
MEMBERSHIP_SERVICE_URL=http://127.0.0.1:8002
CLASS_SERVICE_URL=http://127.0.0.1:8003
BOOKING_SERVICE_URL=http://127.0.0.1:8004
BILLING_SERVICE_URL=http://127.0.0.1:8005
ATTENDANCE_SERVICE_URL=http://127.0.0.1:8006

# ------------------------------------------------------------------------------
# Authentication / JWT Configuration (used by User Service)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=gym_soa_jwt_secret_key_super_secure_32bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# Microservice Ports and Hosts
# ------------------------------------------------------------------------------
USER_SERVICE_PORT=8001
MEMBERSHIP_SERVICE_PORT=8002
CLASS_SERVICE_PORT=8003
BOOKING_SERVICE_PORT=8004
BILLING_SERVICE_PORT=8005
ATTENDANCE_SERVICE_PORT=8006

# ------------------------------------------------------------------------------
# Database Connection Strings (Optional: falls back to local SQLite if empty)
# Format for PostgreSQL: postgresql://user:password@localhost:5432/dbname
# ------------------------------------------------------------------------------
USER_DATABASE_URL=
MEMBERSHIP_DATABASE_URL=
CLASS_DATABASE_URL=
BOOKING_DATABASE_URL=
BILLING_DATABASE_URL=
ATTENDANCE_DATABASE_URL=
